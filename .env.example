# Připojení k PostgreSQL (při `docker compose up -d db` platí tato výchozí hodnota)
DATABASE_URL=postgres://bse:bse-dev-heslo@localhost:5433/bse_erp

# Testovací databáze – testy ji na začátku CELOU SMAŽOU, název musí obsahovat „test“
TEST_DATABASE_URL=postgres://bse:bse-dev-heslo@localhost:5433/bse_erp_test

# Tajný klíč pro šifrování tokenů – dlouhý náhodný řetězec, v produkci jiný než ve vývoji
# (vygenerujete např.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
PAYLOAD_SECRET=

# Veřejná adresa aplikace (v produkci např. https://erp.bsenergetika.cz)
SERVER_URL=http://localhost:3001

# Volitelně: kam ukládat nahrané dokumenty (výchozí ./uploads/dokumenty)
# UPLOADS_DIR=
